}\n.progress > div { height: 100%; background: var(--accent); border-radius: 4px; transition: width .2s; }\n.build-file { margin-top: 8px; font-size: 12px; color: var(--secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* ---------- 调试 ---------- */\n.seg-info { font-size: 14px; color: var(--secondary); padding: 4px 4px 10px; }\n.seg-img { display: none; width: 100%; border-radius: 12px; box-shadow: var(--shadow); margin-bottom: 12px; background: var(--fill); }\n#seg-regions .rr { display: flex; align-items: center; justify-content: space-between; padding: 8px 14px; font-size: 13px; color: var(--secondary); }\n#seg-regions .rr + .rr { border-top: 0.5px solid var(--separator); }\n\n/* ---------- 底部标签栏 ---------- */\n.tabbar {\n  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;\n  height: calc(52px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom);\n  background: rgba(249, 249, 249, 0.92);\n  backdrop-filter: blur(20px) saturate(1.8);\n  -webkit-backdrop-filter: blur(20px) saturate(1.8);\n  border-top: 0.5px solid var(--hairline);\n  display: flex;\n}\n.tabbar button {\n  flex: 1; display: flex; flex-direction: column; align-items: center;\n  justify-content: center; gap: 3px; border: none; background: transparent;\n  color: var(--secondary); font-size: 10px; font-family: inherit; cursor: pointer;\n  transition: color .15s;\n}\n.tabbar button.active { color: var(--accent); }\n.tabbar .icon { width: 25px; height: 25px; }\n\n/* ---------- 图片查看弹窗 ---------- */\n.modal {\n  position: fixed; inset: 0; z-index: 100; display: none;\n  align-items: center; justify-content: center; flex-direction: column;\n  background: rgba(0, 0, 0, 0.92); padding: 20px;\n}\n.modal.open { display: flex; }\n.modal img { max-width: 94%; max-height: 82%; border-radius: 12px; }\n.modal p { margin-top: 14px; color: rgba(255, 255, 255, 0.85); font-size: 13px; word-break: break-all; text-align: center; }\n\n/* ---------- Toast -----